{
  "rules": {
    ".read": false,
    ".write": false,
    "products": {
      ".read": true,
      "$productId": {
        ".write": "auth != null && auth.token.email === 'bodo36711@gmail.com'"
      }
    },
    "orders": {
      ".indexOn": [
        "userId"
      ],
      ".read": "auth != null && (auth.token.email === 'bodo36711@gmail.com' || (query.orderByChild === 'userId' && query.equalTo === auth.uid))",
      "$orderId": {
        ".read": "auth != null && (auth.token.email === 'bodo36711@gmail.com' || data.child('userId').val() === auth.uid)",
        ".write": "auth != null && (auth.token.email === 'bodo36711@gmail.com' || (!data.exists() && newData.child('userId').val() === auth.uid && newData.child('paymentStatus').val() === 'pending' && newData.child('status').val() === 'awaiting_payment' && root.child('products').child(newData.child('productId').val()).child('active').val() === true && root.child('products').child(newData.child('productId').val()).child('price').val() === newData.child('unitPrice').val() && newData.child('total').val() === newData.child('unitPrice').val() && newData.child('quantity').val() === 1))",
        ".validate": "newData.hasChildren(['userId', 'productId', 'productName', 'unitPrice', 'quantity', 'total', 'playerId', 'paymentMethod', 'receiptRef', 'paymentStatus', 'status', 'createdAt'])",
        "userId": {
          ".validate": "newData.isString()"
        },
        "productId": {
          ".validate": "newData.isString()"
        },
        "productName": {
          ".validate": "newData.isString()"
        },
        "unitPrice": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "quantity": {
          ".validate": "newData.val() === 1"
        },
        "total": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "playerId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "paymentMethod": {
          ".validate": "newData.val() === 'instapay' || newData.val() === 'vodafone'"
        },
        "receiptRef": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "paymentStatus": {
          ".validate": "newData.val() === 'pending' || newData.val() === 'paid' || newData.val() === 'rejected'"
        },
        "status": {
          ".validate": "newData.val() === 'awaiting_payment' || newData.val() === 'processing' || newData.val() === 'completed' || newData.val() === 'cancelled'"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "settings": {
      "payments": {
        ".read": true,
        ".write": "auth != null && auth.token.email === 'bodo36711@gmail.com'"
      }
    }
  }
}
